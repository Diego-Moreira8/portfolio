---
import "../styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<html lang="pt-BR">
  <Head title={title} />

  <body class="bg-black font-mono text-white">
    <Header />
    <slot />
  </body>
</html>
