---
import CloseNavButton from "./CloseNavButton.astro";
import Logo from "./Logo.astro";
import NavMobile from "./NavMobile.astro";
import OpenNavButton from "./OpenNavButton.astro";
---

<div class="fixed flex h-full w-full flex-col">
  <header class="border-b border-blue-500 bg-sky-950/80 px-4 backdrop-blur-lg">
    <div class="flex h-15 items-center justify-between">
      <a data-close-nav href="#home"><Logo /></a>

      <!-- Visibilidade dos botões controlada no componente <NavMobile /> -->
      <OpenNavButton />
      <CloseNavButton />
    </div>

    <NavMobile />
  </header>

  <!-- Overlay da nav mobile -->
  <div class="hidden grow bg-black/25" id="nav-overlay" data-close-nav></div>
</div>

<!-- Espaço em branco. Evita que conteúdo apareça atrás do Header -->
<div class="h-15"></div>
