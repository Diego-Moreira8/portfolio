---
import { navLinks } from "@utils/navLinks";
import CloseNavButton from "./CloseNavButton.astro";
---

<!-- top precisa ser a altura do header -->
<dialog
  class="top-15 flex h-full w-full max-w-none flex-col bg-transparent text-white backdrop:bg-transparent"
  id="mobile-nav-dialog"
>
  <CloseNavButton />

  <nav class="hidden" id="mobile-nav">
    <ul class="flex w-full flex-col items-center gap-4 p-4 pt-1">
      {
        navLinks.map((l) => (
          <li>
            <a
              class="px-4 text-center hover:underline"
              data-close-nav
              href={l.href}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Overlay da nav mobile -->
  <div class="hidden grow bg-black/25" id="nav-overlay" data-close-nav></div>
</dialog>

<script>
  const headerHeight = 4 * 15;

  const header = document.querySelector("header") as HTMLElement;

  const dialog = document.getElementById(
    "mobile-nav-dialog",
  ) as HTMLDialogElement;

  const nav = document.getElementById("mobile-nav") as HTMLElement;

  const navOverlay = document.getElementById("nav-overlay") as HTMLDivElement;

  const openNavButton = document.getElementById(
    "open-nav-button",
  ) as HTMLButtonElement;

  const closeNavButton = document.getElementById(
    "close-nav-button",
  ) as HTMLButtonElement;

  const openNavElements = document.querySelectorAll(
    "[data-open-nav]",
  ) as NodeListOf<HTMLElement>;

  const closeNavElements = document.querySelectorAll(
    "[data-close-nav]",
  ) as NodeListOf<HTMLElement>;

  const hideElement = (element: HTMLElement) => element.classList.add("hidden");

  const showElement = (element: HTMLElement) =>
    element.classList.remove("hidden");

  const openNav = () => {
    hideElement(openNavButton);
    showElement(closeNavButton);
    showElement(nav);
    showElement(navOverlay);

    dialog.showModal();

    const navHeight = nav.getBoundingClientRect().height;

    header.style.height = `${headerHeight + navHeight}px`;
  };

  const closeNav = () => {
    hideElement(closeNavButton);
    showElement(openNavButton);
    hideElement(nav);
    hideElement(navOverlay);

    dialog.close();

    header.style.height = `${headerHeight}px`;
  };

  openNavElements.forEach((e) => e.addEventListener("click", openNav));

  closeNavElements.forEach((e) => e.addEventListener("click", closeNav));

  // Necessário para fechar ao rolar a página em mobile
  navOverlay.addEventListener("touchmove", closeNav);
</script>
