---
import { businessInfo } from "@utils/businessInfo";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<head>
  <title>
    {title ? `${title} | ${businessInfo.name}` : businessInfo.name}
  </title>

  <meta name="generator" content={Astro.generator} />

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />

  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta name="description" content={businessInfo.description} />

  <!-- Open Graph tags -->
  <meta property="og:title" content={title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={businessInfo.site} />
  <meta property="og:description" content={businessInfo.description} />
  <!-- <meta property="og:image" content={site + "og-image.jpg"} /> -->
  <!-- <meta property="og:image:alt" content="" /> -->
</head>
