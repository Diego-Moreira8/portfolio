---
import { X } from "@lucide/astro";
---

<!-- 
 Altura precisa ser igual a altura do header.
 Span faz com que apenas o button seja clicável.
-->
<span
  class="fixed top-0 right-4 flex hidden h-15 items-center"
  id="close-nav-button"
>
  <button data-close-nav type="button">
    <X size={20} />
    <span class="sr-only">Fechar menu de navegação</span>
  </button>
</span>
